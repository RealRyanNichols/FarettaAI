{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm -r --workspace-concurrency=1 --filter @gideon/marketing... run build",
  "outputDirectory": "apps/marketing/.next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/marketing packages vercel.json package.json pnpm-lock.yaml"
}
