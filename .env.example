# Supabase — shared across apps + edge functions
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — used by summarization + any Claude-backed admin flows
ANTHROPIC_API_KEY=

# Dashboard — set to the email allow-listed for magic-link auth
DASHBOARD_OPERATOR_EMAIL=

# Faretta marketing — public site URL used for metadata + sitemap.
# Falls back to http://localhost:3002 in dev when unset.
NEXT_PUBLIC_FARETTA_SITE_URL=

# Stripe — subscriptions for Faretta Patriot ($5/mo) and Liberty ($20/mo).
# Get pk_/sk_ from https://dashboard.stripe.com/apikeys.
# Generate the four price IDs by running:
#   STRIPE_SECRET_KEY=sk_... pnpm -F @faretta/marketing stripe:seed
# The whsec_ comes from https://dashboard.stripe.com/webhooks after you
# add an endpoint pointing at https://<your-host>/api/stripe/webhook.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PATRIOT_MONTHLY=
STRIPE_PRICE_PATRIOT_YEARLY=
STRIPE_PRICE_LIBERTY_MONTHLY=
STRIPE_PRICE_LIBERTY_YEARLY=
