{
  "name": "@faretta/brain-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ingest + query client for the Faretta brain_memory layer. Imported by every product app in the portfolio.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "typescript": "^5.6.3"
  }
}
